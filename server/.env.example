# Backend
PORT=4000
# Comma-separated list of allowed origins (leave empty to allow all).
# Example:
# CORS_ORIGINS=http://localhost:3000,https://pradyumchitlu.github.io
CORS_ORIGINS=

# Optional: deliver contact messages to your own webhook.
# If unset, messages append to ../.data/contact-messages.jsonl
CONTACT_WEBHOOK_URL=
